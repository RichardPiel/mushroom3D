# Interface et relais ESP32.
INCUBATOR_PASSWORD=
RELAY_TOKEN=
CAMERA_URL=

# Alerte e-mail si le BME680 ne renvoie plus de température ni d'humidité.
# SMTP_HOST vide : pas d'envoi. Deux mails maximum par heure.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# starttls (port 587), ssl (port 465) ou none
SMTP_TLS=starttls
# Lien placé dans le mail.
INCUBATOR_URL=https://incubator.waterbear.studio
